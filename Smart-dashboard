  </style><h1>تقرير Smart Data Dashboard</h1>
  <p>عدد السجلات: ${filtered.length}</p><div class="kpis">${kpis}</div>
  <div class="charts"><div class="card"><h3>${escapeHTML($('mainChartTitle').textContent)}</h3><img src="${images[0]}"></div>
  <div class="card"><h3>${escapeHTML($('distributionTitle').textContent)}</h3><img src="${images[1]}"></div></div>
  <h2>البيانات المفلترة — أول 1000 صف</h2><table><thead><tr>${headersHTML}</tr></thead><tbody>${tableRows}</tbody></table></html>`;
  download('dashboard-report.html',html,'text/html;charset=utf-8');
}
async function loadSheet() {
  try {
    const url=new URL($('sheetUrl').value.trim());
    if(!url.hostname.includes('docs.google.com'))
      throw Error('أدخل رابط Google Sheets صحيحًا.');
    const match=url.pathname.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
    if(!match) throw Error('تعذر تحديد ملف الشيت من الرابط.');
    const gid=url.searchParams.get('gid') ||
      ((url.hash.match(/gid=(\d+)/)||[])[1]) || '0';
    const csvURL=`https://docs.google.com/spreadsheets/d/${match[1]}/export?format=csv&gid=${gid}`;
    $('sheetStatus').textContent='جاري تحميل الشيت...';
    const response=await fetch(csvURL);
    if(!response.ok) throw Error('تعذر الوصول. تأكد أن الشيت متاح للعرض.');
    const text=await response.text();
    if(/<html|<!doctype/i.test(text))
      throw Error('قد يكون الشيت خاصًا. جرّب تنزيله CSV ورفعه يدويًا.');
    parseCSV(text);
    $('sheetStatus').textContent='تم تحميل الشيت بنجاح.';
  } catch(error) {
    $('sheetStatus').textContent=error.message+' وقد تمنع سياسات Google التحميل المباشر.';
  }
}
